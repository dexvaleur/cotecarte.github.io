# Copie ce fichier en « .env » et adapte les valeurs.
# Sans .env, le serveur démarre en mode développement (base locale PGlite, codes affichés dans le terminal).

# Port d'écoute du serveur
PORT=8787

# Base PostgreSQL (ex. Neon, Supabase, Render…). Vide = base locale PGlite dans ./data/pglite
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/pokecard

# Adresse(s) de l'appli autorisée(s) à appeler l'API (séparées par des virgules)
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Secret pour signer codes et sessions : une longue phrase aléatoire, à garder privée !
# Pour en générer un :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-moi-en-production-avec-une-longue-phrase

# Accès privé : emails autorisés à se connecter, séparés par des virgules.
# Vide = tout le monde peut créer un compte.
# ALLOWED_EMAILS=moi@exemple.fr,ami@exemple.fr

# Envoi des emails (obligatoire en production). Exemples :
#   Brevo : smtp://identifiant:cle@smtp-relay.brevo.com:587
#   Gmail : smtps://ton.adresse%40gmail.com:mot-de-passe-application@smtp.gmail.com:465
# Clé API Brevo (recommandé, envoi par HTTPS) :
# BREVO_API_KEY=
# SMTP_URL=
MAIL_FROM=Poké Card <no-reply@ton-domaine.fr>

# NODE_ENV=production
